{
  "$defs": {
    "CycleContext": {
      "additionalProperties": false,
      "properties": {
        "changed_since": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed Since"
        },
        "mode": {
          "enum": [
            "natural-cycle",
            "other",
            "unknown"
          ],
          "title": "Mode",
          "type": "string"
        },
        "paused": {
          "default": false,
          "title": "Paused",
          "type": "boolean"
        }
      },
      "required": [
        "mode"
      ],
      "title": "CycleContext",
      "type": "object"
    },
    "FeatureValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rational"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "FeatureValue",
      "type": "object"
    },
    "LabelledCase": {
      "additionalProperties": false,
      "properties": {
        "cohort": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Cohort",
          "type": "string"
        },
        "data_kind": {
          "enum": [
            "synthetic",
            "observational"
          ],
          "title": "Data Kind",
          "type": "string"
        },
        "landmark": {
          "$ref": "#/$defs/Landmark"
        },
        "outcome_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Outcome Date",
          "type": "string"
        },
        "outcome_known_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Outcome Known At",
          "type": "string"
        }
      },
      "required": [
        "landmark",
        "outcome_date",
        "outcome_known_at",
        "data_kind",
        "cohort"
      ],
      "title": "LabelledCase",
      "type": "object"
    },
    "Landmark": {
      "additionalProperties": false,
      "properties": {
        "anchor_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Anchor Date",
          "type": "string"
        },
        "anchor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Anchor Id",
          "type": "string"
        },
        "baseline_length": {
          "$ref": "#/$defs/Rational"
        },
        "issues": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "query": {
          "$ref": "#/$defs/Query"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "spec_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Spec Sha256",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Subject Id",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/FeatureValue"
          },
          "maxLength": 64,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "subject_id",
        "anchor_id",
        "anchor_date",
        "query",
        "spec_sha256",
        "snapshot_sha256",
        "baseline_length",
        "values"
      ],
      "title": "Landmark",
      "type": "object"
    },
    "LandmarkSpec": {
      "additionalProperties": false,
      "properties": {
        "elapsed_day": {
          "default": 20,
          "maximum": 180,
          "minimum": 1,
          "title": "Elapsed Day",
          "type": "integer"
        },
        "max_history": {
          "default": 12,
          "maximum": 30,
          "minimum": 1,
          "title": "Max History",
          "type": "integer"
        },
        "metrics": {
          "default": [
            "wrist_temperature",
            "resting_heart_rate",
            "hrv_rmssd",
            "sleep_duration"
          ],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "min_history": {
          "default": 3,
          "maximum": 30,
          "minimum": 1,
          "title": "Min History",
          "type": "integer"
        },
        "minimum_measurement_days": {
          "default": 2,
          "maximum": 14,
          "minimum": 1,
          "title": "Minimum Measurement Days",
          "type": "integer"
        },
        "recent_days": {
          "default": 3,
          "maximum": 14,
          "minimum": 1,
          "title": "Recent Days",
          "type": "integer"
        },
        "reference_days": {
          "default": 7,
          "maximum": 30,
          "minimum": 1,
          "title": "Reference Days",
          "type": "integer"
        },
        "symptoms": {
          "default": [
            "headache",
            "fatigue",
            "abdominal_pain",
            "gastrointestinal"
          ],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "type": "string"
          },
          "title": "Symptoms",
          "type": "array"
        }
      },
      "title": "LandmarkSpec",
      "type": "object"
    },
    "Query": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "As Of",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/CycleContext"
        },
        "cutoff": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Cutoff",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Subject Id",
          "type": "string"
        },
        "utc_offset_minutes": {
          "maximum": 840,
          "minimum": -840,
          "title": "Utc Offset Minutes",
          "type": "integer"
        }
      },
      "required": [
        "subject_id",
        "as_of",
        "cutoff",
        "utc_offset_minutes",
        "context"
      ],
      "title": "Query",
      "type": "object"
    },
    "Rational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "maxLength": 2048,
          "pattern": "^[1-9][0-9]*$",
          "title": "Denominator",
          "type": "string"
        },
        "numerator": {
          "maxLength": 2048,
          "pattern": "^-?(?:0|[1-9][0-9]*)$",
          "title": "Numerator",
          "type": "string"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "Rational",
      "type": "object"
    }
  },
  "$id": "urn:uuid:9339bf59-1d41-583e-a45d-4aeb88382846",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calibration": {
      "items": {
        "$ref": "#/$defs/LabelledCase"
      },
      "maxLength": 5000,
      "title": "Calibration",
      "type": "array"
    },
    "clipping": {
      "default": 8,
      "maximum": 100,
      "minimum": 1,
      "title": "Clipping",
      "type": "integer"
    },
    "quantization": {
      "default": 1000,
      "maximum": 1000000,
      "minimum": 1,
      "title": "Quantization",
      "type": "integer"
    },
    "ridge_penalties": {
      "default": [
        1,
        10,
        100
      ],
      "items": {
        "type": "integer"
      },
      "title": "Ridge Penalties",
      "type": "array"
    },
    "schema_version": {
      "const": "learning-1.0",
      "default": "learning-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/LandmarkSpec"
    },
    "split_mode": {
      "default": "new-subject",
      "enum": [
        "new-subject",
        "forward-personal"
      ],
      "title": "Split Mode",
      "type": "string"
    },
    "train": {
      "items": {
        "$ref": "#/$defs/LabelledCase"
      },
      "maxLength": 5000,
      "title": "Train",
      "type": "array"
    },
    "tune": {
      "items": {
        "$ref": "#/$defs/LabelledCase"
      },
      "maxLength": 5000,
      "title": "Tune",
      "type": "array"
    }
  },
  "required": [
    "train",
    "tune",
    "calibration"
  ],
  "title": "FitRequest",
  "type": "object"
}
