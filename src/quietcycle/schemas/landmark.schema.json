{
  "$defs": {
    "CycleContext": {
      "additionalProperties": false,
      "properties": {
        "changed_since": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed Since"
        },
        "mode": {
          "enum": [
            "natural-cycle",
            "other",
            "unknown"
          ],
          "title": "Mode",
          "type": "string"
        },
        "paused": {
          "default": false,
          "title": "Paused",
          "type": "boolean"
        }
      },
      "required": [
        "mode"
      ],
      "title": "CycleContext",
      "type": "object"
    },
    "FeatureValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rational"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "FeatureValue",
      "type": "object"
    },
    "Query": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "As Of",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/CycleContext"
        },
        "cutoff": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Cutoff",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Subject Id",
          "type": "string"
        },
        "utc_offset_minutes": {
          "maximum": 840,
          "minimum": -840,
          "title": "Utc Offset Minutes",
          "type": "integer"
        }
      },
      "required": [
        "subject_id",
        "as_of",
        "cutoff",
        "utc_offset_minutes",
        "context"
      ],
      "title": "Query",
      "type": "object"
    },
    "Rational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "maxLength": 2048,
          "pattern": "^[1-9][0-9]*$",
          "title": "Denominator",
          "type": "string"
        },
        "numerator": {
          "maxLength": 2048,
          "pattern": "^-?(?:0|[1-9][0-9]*)$",
          "title": "Numerator",
          "type": "string"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "Rational",
      "type": "object"
    }
  },
  "$id": "urn:uuid:3d54b49e-9158-5dc3-a360-45aac27eb74d",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchor_date": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "Anchor Date",
      "type": "string"
    },
    "anchor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
      "title": "Anchor Id",
      "type": "string"
    },
    "baseline_length": {
      "$ref": "#/$defs/Rational"
    },
    "issues": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/Query"
    },
    "snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "spec_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Spec Sha256",
      "type": "string"
    },
    "subject_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
      "title": "Subject Id",
      "type": "string"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/FeatureValue"
      },
      "maxLength": 64,
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "subject_id",
    "anchor_id",
    "anchor_date",
    "query",
    "spec_sha256",
    "snapshot_sha256",
    "baseline_length",
    "values"
  ],
  "title": "Landmark",
  "type": "object"
}
