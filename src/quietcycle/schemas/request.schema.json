    "Bleeding": {
      "additionalProperties": false,
      "description": "A bleeding report is deliberately not an Onset.",
      "properties": {
        "date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Date",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "bleeding",
          "default": "bleeding",
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "recorded_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Recorded At",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "maximum": 100000,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "state": {
          "enum": [
            "none",
            "spotting",
            "flow",
            "uncertain"
          ],
          "title": "State",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Subject Id",
          "type": "string"
        },
        "utc_offset_minutes": {
          "maximum": 840,
          "minimum": -840,
          "title": "Utc Offset Minutes",
          "type": "integer"
        }
      },
      "required": [
        "subject_id",
        "id",
        "recorded_at",
        "utc_offset_minutes",
        "date",
        "state"
      ],
      "title": "Bleeding",
      "type": "object"
    },
