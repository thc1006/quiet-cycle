            "default": "0.3.0",
            "title": "Engine Version",
            "type": "string"
          },
          "feature_builder_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Feature Builder Id",
            "type": "string"
          },
          "forecast": {
            "$ref": "#/components/schemas/Forecast"
          },
          "measurements": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/NormalizedMeasurement"
            },
            "title": "Measurements",
            "type": "array"
          },
          "observation_count": {
            "minimum": 0.0,
            "title": "Observation Count",
            "type": "integer"
          },
          "schema_version": {
            "const": "2.0",
            "default": "2.0",
            "title": "Schema Version",
            "type": "string"
          },
          "snapshot_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Snapshot Sha256",
            "type": "string"
          },
          "subject_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Subject Id",
            "type": "string"
          },
          "symptoms": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SymptomCounts"
            },
            "title": "Symptoms",
            "type": "array"
          },
          "used_features": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
              "type": "string"
            },
            "title": "Used Features",
            "type": "array"
          }
        },
        "required": [
          "subject_id",
          "as_of",
          "cutoff",
          "snapshot_sha256",
          "forecast",
          "observation_count",
          "feature_builder_id",
          "used_features"
        ],
        "title": "PipelineResult",
        "type": "object"
      },
      "Probability": {
        "additionalProperties": false,
        "properties": {
          "denominator": {
            "maxLength": 2048,
            "pattern": "^[1-9][0-9]*$",
            "title": "Denominator",
            "type": "string"
          },
          "numerator": {
            "maxLength": 2048,
            "pattern": "^-?(?:0|[1-9][0-9]*)$",
            "title": "Numerator",
            "type": "string"
          }
        },
        "required": [
          "numerator",
          "denominator"
        ],
        "title": "Probability",
        "type": "object"
      },
      "Provenance": {
        "additionalProperties": false,
        "properties": {
          "imported_at": {
            "anyOf": [
              {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Imported At"
          },
          "source": {
            "default": "manual",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Source",
            "type": "string"
          },
          "source_record_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Record Id"
          }
        },
        "title": "Provenance",
        "type": "object"
      },
      "Query": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "title": "As Of",
            "type": "string"
          },
          "context": {
            "$ref": "#/components/schemas/CycleContext"
          },
          "cutoff": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
            "title": "Cutoff",
            "type": "string"
          },
          "subject_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Subject Id",
            "type": "string"
          },
          "utc_offset_minutes": {
            "maximum": 840,
            "minimum": -840,
            "title": "Utc Offset Minutes",
            "type": "integer"
          }
        },
        "required": [
          "subject_id",
          "as_of",
          "cutoff",
          "utc_offset_minutes",
          "context"
        ],
        "title": "Query",
        "type": "object"
      },
      "Rational": {
        "additionalProperties": false,
        "properties": {
          "denominator": {
            "maxLength": 2048,
            "pattern": "^[1-9][0-9]*$",
            "title": "Denominator",
            "type": "string"
          },
          "numerator": {
            "maxLength": 2048,
            "pattern": "^-?(?:0|[1-9][0-9]*)$",
            "title": "Numerator",
            "type": "string"
          }
        },
        "required": [
          "numerator",
          "denominator"
        ],
        "title": "Rational",
        "type": "object"
      },
      "Symptom": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "title": "Date",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Id",
            "type": "string"
          },
          "impact": {
            "anyOf": [
              {
                "maximum": 3,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Impact"
          },
          "kind": {
            "const": "symptom",
            "default": "symptom",
            "title": "Kind",
            "type": "string"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "recorded_at": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
            "title": "Recorded At",
            "type": "string"
          },
          "revision": {
            "default": 1,
            "maximum": 100000,
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "state": {
            "enum": [
              "present",
              "absent",
              "uncertain",
              "skipped"
            ],
            "title": "State",
            "type": "string"
          },
          "subject_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Subject Id",
            "type": "string"
          },
          "symptom": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Symptom",
            "type": "string"
          },
          "utc_offset_minutes": {
            "maximum": 840,
            "minimum": -840,
            "title": "Utc Offset Minutes",
            "type": "integer"
          }
        },
        "required": [
          "subject_id",
          "id",
          "recorded_at",
          "utc_offset_minutes",
          "date",
          "symptom",
          "state"
        ],
        "title": "Symptom",
        "type": "object"
      },
      "SymptomCounts": {
        "additionalProperties": false,
        "properties": {
          "absent": {
            "minimum": 0.0,
            "title": "Absent",
            "type": "integer"
          },
          "conflicting_days": {
            "minimum": 0.0,
            "title": "Conflicting Days",
            "type": "integer"
          },
          "interpretation": {
            "const": "recorded-days-only-not-a-risk-or-diagnosis",
            "default": "recorded-days-only-not-a-risk-or-diagnosis",
            "title": "Interpretation",
            "type": "string"
          },
          "present": {
            "minimum": 0.0,
            "title": "Present",
            "type": "integer"
          },
          "recalled_reports": {
            "minimum": 0.0,
            "title": "Recalled Reports",
            "type": "integer"
          },
          "skipped": {
            "minimum": 0.0,
            "title": "Skipped",
            "type": "integer"
          },
          "symptom": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Symptom",
            "type": "string"
          },
          "uncertain": {
            "minimum": 0.0,
            "title": "Uncertain",
            "type": "integer"
          }
        },
        "required": [
          "symptom",
          "present",
          "absent",
          "uncertain",
          "skipped",
          "conflicting_days",
          "recalled_reports"
        ],
        "title": "SymptomCounts",
        "type": "object"
      },
      "Tombstone": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "const": "delete",
            "default": "delete",
            "title": "Kind",
            "type": "string"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "recorded_at": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
            "title": "Recorded At",
            "type": "string"
          },
          "revision": {
            "default": 1,
            "maximum": 100000,
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "subject_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Subject Id",
            "type": "string"
          },
          "target_kind": {
            "enum": [
              "onset",
              "no-onset",
              "symptom",
              "checkin",
              "bleeding",
              "measurement"
            ],
            "title": "Target Kind",
            "type": "string"
          },
          "utc_offset_minutes": {
            "maximum": 840,
            "minimum": -840,
            "title": "Utc Offset Minutes",
            "type": "integer"
          }
        },
        "required": [
          "subject_id",
          "id",
          "recorded_at",
          "utc_offset_minutes",
          "target_kind"
        ],
        "title": "Tombstone",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Quiet Cycle API",
    "version": "0.3.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v2/predict": {
      "post": {
        "operationId": "predict_v2_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "dataset": {
                    "$ref": "#/components/schemas/CycleDataset"
                  },
                  "query": {
                    "$ref": "#/components/schemas/Query"
                  },
                  "schema_version": {
                    "const": "2.0",
                    "default": "2.0",
                    "title": "Schema Version",
                    "type": "string"
                  }
                },
                "required": [
                  "dataset",
                  "query"
                ],
                "title": "PipelineRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "description": "Input exceeds 16 MiB"
          },
          "422": {
            "description": "Invalid input; error values are redacted"
          }
        },
        "summary": "Predict"
      }
    }
  }
}
