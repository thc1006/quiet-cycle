include constraints-contracts.txt constraints-tested.txt llms.txt
include LICENSE NOTICE README.md README.zh-TW.md CHANGELOG.md CONTRIBUTING.md SECURITY.md AGENTS.md CLAUDE.md CITATION.cff
recursive-include src/quietcycle *.py *.typed *.json
recursive-include tests *.py *.js *.mjs *.json LICENSE
recursive-include examples *.py *.json *.jsonl *.csv *.mjs
recursive-include docs *.md
recursive-include prompts *.md
recursive-include scripts *.py
recursive-include contracts *.json
exclude .coverage
prune .git
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache
prune build
prune dist
prune evidence
prune **/__pycache__
global-exclude *.py[cod]
