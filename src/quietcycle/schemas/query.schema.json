{
  "$defs": {
    "CycleContext": {
      "additionalProperties": false,
      "properties": {
        "changed_since": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed Since"
        },
        "mode": {
          "enum": [
            "natural-cycle",
            "other",
            "unknown"
          ],
          "title": "Mode",
          "type": "string"
        },
        "paused": {
          "default": false,
          "title": "Paused",
          "type": "boolean"
        }
      },
      "required": [
        "mode"
      ],
      "title": "CycleContext",
      "type": "object"
    }
  },
  "$id": "urn:uuid:f6527870-656a-567d-94cd-f681c8d48b3d",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "As Of",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/CycleContext"
    },
    "cutoff": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Cutoff",
      "type": "string"
    },
    "subject_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
      "title": "Subject Id",
      "type": "string"
    },
    "utc_offset_minutes": {
      "maximum": 840,
      "minimum": -840,
      "title": "Utc Offset Minutes",
      "type": "integer"
    }
  },
  "required": [
    "subject_id",
    "as_of",
    "cutoff",
    "utc_offset_minutes",
    "context"
  ],
  "title": "Query",
  "type": "object"
}
