{
  "$defs": {
    "CalibratedInterval": {
      "additionalProperties": false,
      "properties": {
        "assumption": {
          "enum": [
            "exchangeable-new-subjects-required",
            "dependent-time-series-no-coverage-guarantee"
          ],
          "title": "Assumption",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        },
        "nominal_coverage_ppm": {
          "exclusiveMaximum": 1000000,
          "exclusiveMinimum": 0,
          "title": "Nominal Coverage Ppm",
          "type": "integer"
        },
        "radius_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Radius Days"
        },
        "start": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "unbounded": {
          "title": "Unbounded",
          "type": "boolean"
        }
      },
      "required": [
        "nominal_coverage_ppm",
        "start",
        "end",
        "radius_days",
        "unbounded",
        "assumption"
      ],
      "title": "CalibratedInterval",
      "type": "object"
    },
    "Contribution": {
      "additionalProperties": false,
      "properties": {
        "days": {
          "$ref": "#/$defs/Rational"
        },
        "term": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "term",
        "days"
      ],
      "title": "Contribution",
      "type": "object"
    },
    "Rational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "maxLength": 2048,
          "pattern": "^[1-9][0-9]*$",
          "title": "Denominator",
          "type": "string"
        },
        "numerator": {
          "maxLength": 2048,
          "pattern": "^-?(?:0|[1-9][0-9]*)$",
          "title": "Numerator",
          "type": "string"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "Rational",
      "type": "object"
    }
  },
  "$id": "urn:uuid:f1a45a23-5078-55a2-b6fb-9a988d226edb",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "As Of",
      "type": "string"
    },
    "baseline_cycle_length": {
      "anyOf": [
        {
          "$ref": "#/$defs/Rational"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "clinical_validation": {
      "const": "not-established",
      "default": "not-established",
      "title": "Clinical Validation",
      "type": "string"
    },
    "contributions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Contribution"
      },
      "title": "Contributions",
      "type": "array"
    },
    "cutoff": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Cutoff",
      "type": "string"
    },
    "intervals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CalibratedInterval"
      },
      "title": "Intervals",
      "type": "array"
    },
    "issues": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "model_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Model Sha256",
      "type": "string"
    },
    "point_cycle_length": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Point Cycle Length"
    },
    "point_date": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Point Date"
    },
    "raw_cycle_length": {
      "anyOf": [
        {
          "$ref": "#/$defs/Rational"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "learning-1.0",
      "default": "learning-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "estimate",
        "abstain"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
      "title": "Subject Id",
      "type": "string"
    }
  },
  "required": [
    "model_sha256",
    "subject_id",
    "as_of",
    "cutoff",
    "status",
    "reason"
  ],
  "title": "LearnedPrediction",
  "type": "object"
}
