{
  "$defs": {
    "Forecast": {
      "additionalProperties": false,
      "properties": {
        "audit": {
          "$ref": "#/$defs/ForecastAudit"
        },
        "calibration": {
          "const": "unvalidated",
          "default": "unvalidated",
          "title": "Calibration",
          "type": "string"
        },
        "distribution": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MassPoint"
          },
          "title": "Distribution",
          "type": "array"
        },
        "intervals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelInterval"
          },
          "title": "Intervals",
          "type": "array"
        },
        "model_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Model Version",
          "type": "string"
        },
        "point_date": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point Date"
        },
        "reason": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "estimate",
            "abstain"
          ],
          "title": "Status",
          "type": "string"
        },
        "unmodeled_risk": {
          "const": "not-quantified",
          "default": "not-quantified",
          "title": "Unmodeled Risk",
          "type": "string"
        },
        "within_three_days": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "reason"
      ],
      "title": "Forecast",
      "type": "object"
    },
    "ForecastAudit": {
      "additionalProperties": false,
      "properties": {
        "anchor_date": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Date"
        },
        "history_lengths": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "History Lengths",
          "type": "array"
        },
        "interval_count": {
          "default": 0,
          "minimum": 0,
          "title": "Interval Count",
          "type": "integer"
        },
        "no_onset_through": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Onset Through"
        },
        "survival_mass": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unresolved_past_mass": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ForecastAudit",
      "type": "object"
    },
    "MassPoint": {
      "additionalProperties": false,
      "properties": {
        "cycle_length": {
          "minimum": 1,
          "title": "Cycle Length",
          "type": "integer"
        },
        "date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Date",
          "type": "string"
        },
        "mass": {
          "$ref": "#/$defs/Probability"
        },
        "ppm": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Ppm",
          "type": "integer"
        }
      },
      "required": [
        "date",
        "cycle_length",
        "mass",
        "ppm"
      ],
      "title": "MassPoint",
      "type": "object"
    },
    "ModelInterval": {
      "additionalProperties": false,
      "properties": {
        "calibrated": {
          "const": false,
          "default": false,
          "title": "Calibrated",
          "type": "boolean"
        },
        "end": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "End",
          "type": "string"
        },
        "included_mass": {
          "$ref": "#/$defs/Probability"
        },
        "requested_mass_ppm": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Requested Mass Ppm",
          "type": "integer"
        },
        "start": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "requested_mass_ppm",
        "included_mass"
      ],
      "title": "ModelInterval",
      "type": "object"
    },
    "NormalizedMeasurement": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Available At",
          "type": "string"
        },
        "body_site": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Site"
        },
        "date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Date",
          "type": "string"
        },
        "event_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Event Id",
          "type": "string"
        },
        "measured_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Measured At",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "metric": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Metric",
          "type": "string"
        },
        "source": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Source",
          "type": "string"
        },
        "state": {
          "enum": [
            "measured",
            "missing"
          ],
          "title": "State",
          "type": "string"
        },
        "unit": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9\\[\\]{}./%_-]+$",
          "title": "Unit",
          "type": "string"
        },
        "used_by_default_model": {
          "const": false,
          "default": false,
          "title": "Used By Default Model",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rational"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event_id",
        "date",
        "measured_at",
        "available_at",
        "metric",
        "value",
        "unit",
        "state",
        "source"
      ],
      "title": "NormalizedMeasurement",
      "type": "object"
    },
    "Probability": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "maxLength": 2048,
          "pattern": "^[1-9][0-9]*$",
          "title": "Denominator",
          "type": "string"
        },
        "numerator": {
          "maxLength": 2048,
          "pattern": "^-?(?:0|[1-9][0-9]*)$",
          "title": "Numerator",
          "type": "string"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "Probability",
      "type": "object"
    },
    "Rational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "maxLength": 2048,
          "pattern": "^[1-9][0-9]*$",
          "title": "Denominator",
          "type": "string"
        },
        "numerator": {
          "maxLength": 2048,
          "pattern": "^-?(?:0|[1-9][0-9]*)$",
          "title": "Numerator",
          "type": "string"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "Rational",
      "type": "object"
    },
    "SymptomCounts": {
      "additionalProperties": false,
      "properties": {
        "absent": {
          "minimum": 0,
          "title": "Absent",
          "type": "integer"
        },
        "conflicting_days": {
          "minimum": 0,
          "title": "Conflicting Days",
          "type": "integer"
        },
        "interpretation": {
          "const": "recorded-days-only-not-a-risk-or-diagnosis",
          "default": "recorded-days-only-not-a-risk-or-diagnosis",
          "title": "Interpretation",
          "type": "string"
        },
        "present": {
          "minimum": 0,
          "title": "Present",
          "type": "integer"
        },
        "recalled_reports": {
          "minimum": 0,
          "title": "Recalled Reports",
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "symptom": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Symptom",
          "type": "string"
        },
        "uncertain": {
          "minimum": 0,
          "title": "Uncertain",
          "type": "integer"
        }
      },
      "required": [
        "symptom",
        "present",
        "absent",
        "uncertain",
        "skipped",
        "conflicting_days",
        "recalled_reports"
      ],
      "title": "SymptomCounts",
      "type": "object"
    }
  },
  "$id": "urn:uuid:de74213a-f015-56f8-9c9b-542e484cd371",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "As Of",
      "type": "string"
    },
    "cutoff": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Cutoff",
      "type": "string"
    },
    "engine_version": {
      "default": "0.3.0",
      "title": "Engine Version",
      "type": "string"
    },
    "feature_builder_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
      "title": "Feature Builder Id",
      "type": "string"
    },
    "forecast": {
      "$ref": "#/$defs/Forecast"
    },
    "measurements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NormalizedMeasurement"
      },
      "title": "Measurements",
      "type": "array"
    },
    "observation_count": {
      "minimum": 0,
      "title": "Observation Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "subject_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
      "title": "Subject Id",
      "type": "string"
    },
    "symptoms": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SymptomCounts"
      },
      "title": "Symptoms",
      "type": "array"
    },
    "used_features": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
        "type": "string"
      },
      "title": "Used Features",
      "type": "array"
    }
  },
  "required": [
    "subject_id",
    "as_of",
    "cutoff",
    "snapshot_sha256",
    "forecast",
    "observation_count",
    "feature_builder_id",
    "used_features"
  ],
  "title": "PipelineResult",
  "type": "object"
}
