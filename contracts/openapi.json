            "type": "boolean"
          }
        },
        "required": [
          "mode"
        ],
        "title": "CycleContext",
        "type": "object"
      },
      "CycleDataset": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "discriminator": {
                "mapping": {
                  "bleeding": "#/components/schemas/Bleeding",
                  "checkin": "#/components/schemas/Checkin",
                  "delete": "#/components/schemas/Tombstone",
                  "measurement": "#/components/schemas/Measurement",
                  "no-onset": "#/components/schemas/NoOnset",
                  "onset": "#/components/schemas/Onset",
                  "symptom": "#/components/schemas/Symptom"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Onset"
                },
                {
                  "$ref": "#/components/schemas/NoOnset"
                },
                {
                  "$ref": "#/components/schemas/Symptom"
                },
                {
                  "$ref": "#/components/schemas/Checkin"
                },
                {
                  "$ref": "#/components/schemas/Bleeding"
                },
                {
                  "$ref": "#/components/schemas/Measurement"
                },
                {
                  "$ref": "#/components/schemas/Tombstone"
                }
              ]
            },
            "maxLength": 50000,
            "title": "Events",
            "type": "array"
          },
          "schema_version": {
            "const": "2.0",
            "default": "2.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "events"
        ],
        "title": "CycleDataset",
        "type": "object"
      },
