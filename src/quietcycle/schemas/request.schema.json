    "CycleDataset": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "discriminator": {
              "mapping": {
                "bleeding": "#/$defs/Bleeding",
                "checkin": "#/$defs/Checkin",
                "delete": "#/$defs/Tombstone",
                "measurement": "#/$defs/Measurement",
                "no-onset": "#/$defs/NoOnset",
                "onset": "#/$defs/Onset",
                "symptom": "#/$defs/Symptom"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Onset"
              },
              {
                "$ref": "#/$defs/NoOnset"
              },
              {
                "$ref": "#/$defs/Symptom"
              },
              {
                "$ref": "#/$defs/Checkin"
              },
              {
                "$ref": "#/$defs/Bleeding"
              },
              {
                "$ref": "#/$defs/Measurement"
              },
              {
                "$ref": "#/$defs/Tombstone"
              }
            ]
          },
          "maxLength": 50000,
          "title": "Events",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
