{
  "$defs": {
    "LandmarkSpec": {
      "additionalProperties": false,
      "properties": {
        "elapsed_day": {
          "default": 20,
          "maximum": 180,
          "minimum": 1,
          "title": "Elapsed Day",
          "type": "integer"
        },
        "max_history": {
          "default": 12,
          "maximum": 30,
          "minimum": 1,
          "title": "Max History",
          "type": "integer"
        },
        "metrics": {
          "default": [
            "wrist_temperature",
            "resting_heart_rate",
            "hrv_rmssd",
            "sleep_duration"
          ],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "min_history": {
          "default": 3,
          "maximum": 30,
          "minimum": 1,
          "title": "Min History",
          "type": "integer"
        },
        "minimum_measurement_days": {
          "default": 2,
          "maximum": 14,
          "minimum": 1,
          "title": "Minimum Measurement Days",
          "type": "integer"
        },
        "recent_days": {
          "default": 3,
          "maximum": 14,
          "minimum": 1,
          "title": "Recent Days",
          "type": "integer"
        },
        "reference_days": {
          "default": 7,
          "maximum": 30,
          "minimum": 1,
          "title": "Reference Days",
          "type": "integer"
        },
        "symptoms": {
          "default": [
            "headache",
            "fatigue",
            "abdominal_pain",
            "gastrointestinal"
          ],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "type": "string"
          },
          "title": "Symptoms",
          "type": "array"
        }
      },
      "title": "LandmarkSpec",
      "type": "object"
    },
    "LinearCandidate": {
      "additionalProperties": false,
      "properties": {
        "blend": {
          "$ref": "#/$defs/Rational"
        },
        "coefficients": {
          "items": {
            "$ref": "#/$defs/Rational"
          },
          "maxLength": 128,
          "title": "Coefficients",
          "type": "array"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Name",
          "type": "string"
        },
        "penalty": {
          "minimum": 0,
          "title": "Penalty",
          "type": "integer"
        },
        "terms": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "type": "string"
          },
          "title": "Terms",
          "type": "array"
        },
        "tune_mse": {
          "$ref": "#/$defs/Rational"
        }
      },
      "required": [
        "name",
        "penalty",
        "terms",
        "coefficients",
        "blend",
        "tune_mse"
      ],
      "title": "LinearCandidate",
      "type": "object"
    },
    "Rational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "maxLength": 2048,
          "pattern": "^[1-9][0-9]*$",
          "title": "Denominator",
          "type": "string"
        },
        "numerator": {
          "maxLength": 2048,
          "pattern": "^-?(?:0|[1-9][0-9]*)$",
          "title": "Numerator",
          "type": "string"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "Rational",
      "type": "object"
    },
    "ScaleColumn": {
      "additionalProperties": false,
      "properties": {
        "center": {
          "$ref": "#/$defs/Rational"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "title": "Name",
          "type": "string"
        },
        "observed_in_train": {
          "title": "Observed In Train",
          "type": "boolean"
        },
        "scale": {
          "$ref": "#/$defs/Rational"
        }
      },
      "required": [
        "name",
        "center",
        "scale",
        "observed_in_train"
      ],
      "title": "ScaleColumn",
      "type": "object"
    }
  },
  "$id": "urn:uuid:60ad4efa-ca5d-5355-91ce-b86326040ab0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "exact-landmark-ridge-ensemble-v1",
      "default": "exact-landmark-ridge-ensemble-v1",
      "title": "Algorithm",
      "type": "string"
    },
    "available_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Available At",
      "type": "string"
    },
    "calibration_count": {
      "minimum": 1,
      "title": "Calibration Count",
      "type": "integer"
    },
    "calibration_scores": {
      "items": {
        "type": "integer"
      },
      "title": "Calibration Scores",
      "type": "array"
    },
    "calibration_subject_hashes": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "title": "Calibration Subject Hashes",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/LinearCandidate"
      },
      "maxLength": 33,
      "title": "Candidates",
      "type": "array"
    },
    "clinical_validation": {
      "const": "not-established",
      "default": "not-established",
      "title": "Clinical Validation",
      "type": "string"
    },
    "clipping": {
      "maximum": 100,
      "minimum": 1,
      "title": "Clipping",
      "type": "integer"
    },
    "cohorts": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
        "type": "string"
      },
      "title": "Cohorts",
      "type": "array"
    },
    "columns": {
      "items": {
        "$ref": "#/$defs/ScaleColumn"
      },
      "maxLength": 64,
      "title": "Columns",
      "type": "array"
    },
    "data_kind": {
      "enum": [
        "synthetic",
        "observational"
      ],
      "title": "Data Kind",
      "type": "string"
    },
    "fitted_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Fitted At",
      "type": "string"
    },
    "quantization": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Quantization",
      "type": "integer"
    },
    "schema_version": {
      "const": "learning-1.0",
      "default": "learning-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected": {
      "$ref": "#/$defs/LinearCandidate"
    },
    "spec": {
      "$ref": "#/$defs/LandmarkSpec"
    },
    "split_mode": {
      "enum": [
        "new-subject",
        "forward-personal"
      ],
      "title": "Split Mode",
      "type": "string"
    },
    "train_count": {
      "minimum": 8,
      "title": "Train Count",
      "type": "integer"
    },
    "train_subject_hashes": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "title": "Train Subject Hashes",
      "type": "array"
    },
    "training_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Training Digest",
      "type": "string"
    },
    "tune_count": {
      "minimum": 4,
      "title": "Tune Count",
      "type": "integer"
    },
    "tune_subject_hashes": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "title": "Tune Subject Hashes",
      "type": "array"
    }
  },
  "required": [
    "spec",
    "columns",
    "clipping",
    "quantization",
    "selected",
    "candidates",
    "calibration_scores",
    "train_count",
    "tune_count",
    "calibration_count",
    "train_subject_hashes",
    "tune_subject_hashes",
    "calibration_subject_hashes",
    "split_mode",
    "fitted_at",
    "available_at",
    "training_digest",
    "data_kind",
    "cohorts"
  ],
  "title": "FittedModel",
  "type": "object"
}
